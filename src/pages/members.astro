---
import { getCollection } from 'astro:content';
import { MEMBERS_PAGE } from '../config';
import SiteLayout from '../layouts/SiteLayout.astro';

const members = (
  await getCollection('members', ({ data }) => !data.draft)
).sort((a, b) => {
  if (a.data.order !== b.data.order) {
    return a.data.order - b.data.order;
  }
  return a.data.name.localeCompare(b.data.name);
});

const GROUP_ORDER = ['Management', 'Member'];

const groupedByGroup = members.reduce(
  (acc, m) => {
    const g = m.data.group ?? 'Member';
    acc[g] = acc[g] ?? [];
    acc[g].push(m);
    return acc;
  },
  {} as Record<string, typeof members>
);

const groups = GROUP_ORDER.filter((g) => groupedByGroup[g]?.length > 0);

const memberCountLabel = `${members.length} ${
  members.length === 1 ? 'member' : 'members'
}`;
---

<SiteLayout title={MEMBERS_PAGE.title} description={MEMBERS_PAGE.description}>
  <section class="page-hero members-hero">
    <p class="eyebrow">{MEMBERS_PAGE.eyebrow}</p>
    <h1>{MEMBERS_PAGE.heading}</h1>
    <p class="lead">{MEMBERS_PAGE.lead}</p>
    <div class="members-summary" aria-label="Member directory summary">
      <span>{memberCountLabel}</span>
    </div>
  </section>

  <section class="members-section">
    {
      members.length === 0 ? (
        <p class="lead">{MEMBERS_PAGE.emptyState}</p>
      ) : (
        groups.map((group) => (
          <div class="member-group-section">
            <div class="member-group-header">
              <h2>{group === 'Member' ? 'Members' : group}</h2>
            </div>

            <div class="member-grid">
              {groupedByGroup[group].map((member) => (
                <article class="member-card">
                  <div class="member-card-layout">
                    <div class="member-profile">
                      <div class="member-avatar-wrapper">
                        {member.data.github ? (
                          <a
                            href={member.data.github}
                            target="_blank"
                            rel="noreferrer"
                            class="member-avatar-link"
                          >
                            {member.data.avatar ? (
                              <>
                                <img
                                  class="member-avatar"
                                  src={member.data.avatar}
                                  alt={`${member.data.name} avatar`}
                                  loading="lazy"
                                  onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                                />
                                <div
                                  class="member-avatar member-avatar-fallback"
                                  style="display: none;"
                                >
                                  {member.data.name
                                    .split(' ')
                                    .map((p) => p[0])
                                    .join('')
                                    .slice(0, 2)}
                                </div>
                              </>
                            ) : (
                              <img
                                class="member-avatar"
                                src={`${member.data.github.replace(/\/$/, '')}.png`}
                                alt={`${member.data.name} avatar`}
                                loading="lazy"
                                onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                              />
                            )}
                            <div
                              class="member-avatar member-avatar-fallback"
                              style={
                                member.data.avatar
                                  ? 'display: none;'
                                  : 'display: none;'
                              }
                            >
                              {member.data.name
                                .split(' ')
                                .map((p) => p[0])
                                .join('')
                                .slice(0, 2)}
                            </div>
                          </a>
                        ) : member.data.avatar ? (
                          <img
                            class="member-avatar"
                            src={member.data.avatar}
                            alt={`${member.data.name} avatar`}
                            loading="lazy"
                            onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                          />
                        ) : (
                          <div class="member-avatar member-avatar-fallback">
                            {member.data.name
                              .split(' ')
                              .map((p) => p[0])
                              .join('')
                              .slice(0, 2)}
                          </div>
                        )}
                      </div>

                      <h4>
                        {member.data.github ? (
                          <a
                            href={member.data.github}
                            target="_blank"
                            rel="noreferrer"
                            class="member-name-link"
                          >
                            {member.data.name}
                          </a>
                        ) : (
                          member.data.name
                        )}
                      </h4>

                      {member.data.badge && (
                        <span
                          class={`member-badge member-badge--${member.data.badge.toLowerCase()}`}
                        >
                          {member.data.badge}
                        </span>
                      )}
                    </div>

                    <div class="member-social-icons">
                      {member.data.github && (
                        <a
                          href={member.data.github}
                          target="_blank"
                          rel="noreferrer"
                          aria-label="GitHub"
                        >
                          <svg
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            fill="currentColor"
                          >
                            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                          </svg>
                        </a>
                      )}
                      {member.data.linkedin && (
                        <a
                          href={member.data.linkedin}
                          target="_blank"
                          rel="noreferrer"
                          aria-label="LinkedIn"
                        >
                          <svg
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            fill="currentColor"
                          >
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                          </svg>
                        </a>
                      )}
                      {member.data.instagram && (
                        <a
                          href={member.data.instagram}
                          target="_blank"
                          rel="noreferrer"
                          aria-label="Instagram"
                        >
                          <svg
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            fill="currentColor"
                          >
                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
                          </svg>
                        </a>
                      )}
                      {member.data.website && (
                        <a
                          href={member.data.website}
                          target="_blank"
                          rel="noreferrer"
                          aria-label="Website"
                        >
                          <svg
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            fill="currentColor"
                          >
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
                          </svg>
                        </a>
                      )}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))
      )
    }
  </section>
</SiteLayout>
