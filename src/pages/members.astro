---
import { getCollection } from 'astro:content';
import { MEMBERS_PAGE } from '../config';
import SiteLayout from '../layouts/SiteLayout.astro';
import MemberSocials from '../components/MemberSocials.astro';
import { avatarUrl, initials } from '../utils/members';
import { withBase } from '../utils/base';

const members = (
  await getCollection('members', ({ data }) => !data.draft)
).sort((a, b) =>
  a.data.order !== b.data.order
    ? a.data.order - b.data.order
    : a.data.name.localeCompare(b.data.name)
);

const memberCountLabel = `${members.length} ${
  members.length === 1 ? 'member' : 'members'
}`;
---

<SiteLayout title={MEMBERS_PAGE.title} description={MEMBERS_PAGE.description}>
  <section class="page-hero members-hero">
    <p class="eyebrow">{MEMBERS_PAGE.eyebrow}</p>
    <h1>{MEMBERS_PAGE.heading}</h1>
    <p class="lead">{MEMBERS_PAGE.lead}</p>
    <div class="members-summary" aria-label="Member directory summary">
      <span>{memberCountLabel}</span>
    </div>
  </section>

  <section class="members-section">
    {
      members.length === 0 ? (
        <p class="lead">{MEMBERS_PAGE.emptyState}</p>
      ) : (
        <div class="member-grid">
          {members.map((member) => (
            <article class="member-card">
              <div class="member-card-layout">
                <div class="member-profile">
                  <a
                    href={withBase(`/members/${member.id}/`)}
                    class="member-avatar-link"
                  >
                    <img
                      class="member-avatar"
                      src={avatarUrl(member)}
                      alt={`${member.data.name} avatar`}
                      loading="lazy"
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                    />
                    <div
                      class="member-avatar member-avatar-fallback"
                      style="display: none;"
                    >
                      {initials(member.data.name)}
                    </div>
                  </a>

                  <h4>
                    <a
                      href={withBase(`/members/${member.id}/`)}
                      class="member-name-link"
                    >
                      {member.data.name}
                    </a>
                  </h4>

                  <span
                    class={`member-badge member-badge--${member.data.role.toLowerCase()}`}
                  >
                    {member.data.role}
                  </span>
                </div>

                <MemberSocials member={member} />
              </div>
            </article>
          ))}
        </div>
      )
    }
  </section>
</SiteLayout>
